{
  "manifest_version": 3,
  "name": "formwork",
  "version": "0.1.20",
  "description": "Fill any job application from your own profile, with every answer reviewable before you submit.",
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/content/job-context.js",
        "src/content/detect.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Fill this application with formwork"
  },
  "options_page": "src/options/options.html"
}
